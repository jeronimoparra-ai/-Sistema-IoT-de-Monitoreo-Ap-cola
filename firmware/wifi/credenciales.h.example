#ifndef CREDENCIALES_H
#define CREDENCIALES_H

// ===== WiFi =====
// Nombre de tu red WiFi (solo 2.4 GHz)
#define WIFI_SSID     "NombreDeTuRedWiFi"

// Contraseña de tu red WiFi
#define WIFI_PASSWORD "TuContraseñaWiFi"

// ===== ThingSpeak =====
// Write API Key — la encuentras en tu canal: API Keys tab
#define TS_API_KEY    "XXXXXXXXXXXXXXXX"

// Channel ID — número que aparece en tu canal de ThingSpeak
#define TS_CHANNEL_ID 1234567

#endif // CREDENCIALES_H
